# Copy to frontend/.env.local for local development.
# Only PUBLIC values belong here: everything prefixed VITE_ is bundled into the
# JavaScript that every visitor downloads. Never put secrets in this file.

# Clerk dashboard -> API keys -> Publishable key (pk_test_... / pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>

# Backend API base. Leave unset locally (Vite proxies /api to Flask).
# Production (Vercel): https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=

# Public school code used by the website admission enquiry form.
VITE_PUBLIC_INSTITUTION_CODE=STXAV-DELHI
