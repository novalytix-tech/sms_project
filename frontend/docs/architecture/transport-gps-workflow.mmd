flowchart TD
    classDef verifiedLogic fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef decisionCheck fill:#fffbeb,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef missingIntegration fill:#fef2f2,stroke:#ef4444,stroke-width:2px,stroke-dasharray: 5 5,color:#991b1b;
    classDef storageState fill:#faf5ff,stroke:#9333ea,stroke-width:2px,color:#581c87;
    classDef clientMap fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a;

    subgraph SETUP_AND_ENROLLMENT ["1. Route Setup & Student Enrollment"]
        RouteConfig["Admin configures Route in transportRoutes:
        * Vehicle Registration (e.g. KA-01-FA-4421)
        * Capacity (e.g. 45 Seats)
        * Driver Name & Mobile, Attendant Name & Mobile
        * Stops with Coordinates (lat, lng, pickup/drop times)
        * School Campus Destination Coordinates"]:::verifiedLogic

        StudentEnroll["Student Commute Enrollment:
        * transportService.assignTransport(studentId, routeId, stop)
        * Links student.transportRouteId and student.busStop
        * Increments route.assignedStudentsCount"]:::verifiedLogic

        CapacityCheck{"assignedStudentsCount > capacity?"}:::decisionCheck
        StudentEnroll --> CapacityCheck
        CapacityCheck -->|Yes| OverCapacityWarning["Over-Capacity Warning Flagged on Route Card"]
        CapacityCheck -->|No| NormalAllocation["Seat Successfully Allocated"]

        RouteConfig --> StudentEnroll
    end

    subgraph TELEMATICS_REALITY ["2. GPS Telematics Source (SIMULATION vs REAL HARDWARE)"]
        DemoSim["[CURRENT WORKING IMPLEMENTATION]
        gpsService.simulateStepAlongRoute()
        * Step interpolation between stop coordinates
        * Triggered by user clicking 'Simulate Move [DEMO]'
        * isSimulated: true, sourceDeviceId: 'DEMO-SIM-01'"]:::verifiedLogic

        PhysicalTracker["[MISSING IN PRODUCTION]
        Physical Hardware OBD-II / Cellular Tracker
        * Teltonika FMB003 / FMB920 sending NMEA over 4G
        * Cellular Gateway / Traccar TCP listener
        * Server API: POST /api/v1/telematics/push"]:::missingIntegration

        PacketValidation["gpsService.validateGpsUpdate() (CLIENT-SIDE)
        * Latitude between -90 and +90
        * Longitude between -180 and +180
        * Clock skew check (< 5 mins in future)
        * Chronological sequence check (newer than last packet)"]:::verifiedLogic

        DemoSim --> PacketValidation
        PhysicalTracker -.->|Planned Pipeline| PacketValidation
    end

    subgraph TELEMETRY_PROCESSING ["3. Telematics & Freshness Processing"]
        FreshnessCalc["Evaluate Data Freshness:
        * Age < 90s -> 'live' (Green pulse ring)
        * Age 90s - 10m -> 'stale' (Orange warning)
        * Age > 10m -> 'offline' (Grey indicator)"]:::verifiedLogic

        GeoCalc["Haversine Geofence & Deviation Engine:
        * Calculate distance to all route stops
        * If minDistance > 450m -> trip.hasDeviationAlert = true
        * Compute ETA in minutes to upcoming stops"]:::verifiedLogic

        AlertCheck{"Route Deviation > 450m OR GPS Offline?"}:::decisionCheck

        PacketValidation --> FreshnessCalc --> GeoCalc --> AlertCheck

        CreateAlert["transportAlertService.createAlert()
        * 5-Minute Cooldown Throttling (no spam)
        * Scoped to affected route & linked students"]:::verifiedLogic

        AlertCheck -->|Yes| CreateAlert
        AlertCheck -->|No| UpdateStore

        UpdateStore["Save BusLocationUpdate to ERPStorage:
        * trip.lastLocationUpdate = update
        * Append to transportLocations history"]:::storageState
        CreateAlert --> UpdateStore
    end

    subgraph PRESENTATION_AND_ISOLATION ["4. Presentation & Privacy Scoping"]
        UserRoleCheck{"Viewing User Role?"}:::decisionCheck
        UpdateStore --> UserRoleCheck

        AdminFleetView["School Admin / Transport Manager:
        * 5-Tab Fleet & Trips Console
        * Full multi-route interactive Leaflet Map
        * Daily Trips, Attendant Check-In, Safety Logs, Alerts"]:::clientMap

        OptedParentView["Opted Student / Linked Parent:
        * Leaflet map strictly isolated to assigned bus
        * Designated stop highlighted with star ('★ YOUR STOP')
        * Real-time ETA counter & GPS status badge
        * Today's Boarding / Drop Status Timeline"]:::clientMap

        NonOptedBlocked["Non-Opted Student / Parent:
        * Hidden from sidebar
        * /transport displays 'Transport Facility Not Opted'
        * Zero route, bus, driver or stop data leaked"]:::verifiedLogic

        UserRoleCheck -->|school_admin / super_admin| AdminFleetView
        UserRoleCheck -->|opted student / parent| OptedParentView
        UserRoleCheck -->|non-opted student / parent| NonOptedBlocked
    end

    subgraph SAFETY_MANIFEST ["5. Safety Checkpoints & Audit History"]
        CheckInTrigger["Attendant opens Boarding Check-In Modal"]
        SelectMethod["Select Verification Method:
        * Manual Attendant Roster (Current)
        * [PLANNED] Camera QR Scanner (html5-qrcode)
        * [PLANNED] RFID Bus Gate Card Swipe
        * Emergency Safety Override"]:::verifiedLogic

        ActionRecord["Attendant marks student status:
        * 'boarded' | 'dropped_off' | 'not_boarded'"]:::verifiedLogic

        CheckInTrigger --> SelectMethod --> ActionRecord

        DupCheck{"Duplicate Boarding on Same Trip?"}:::decisionCheck
        ActionRecord --> DupCheck
        DupCheck -->|Yes| BlockDup["BLOCKED: Student already boarded at HH:MM"]:::verifiedLogic

        SeqCheck{"Dropped off without prior Boarding?"}:::decisionCheck
        DupCheck -->|No| SeqCheck
        SeqCheck -->|Yes| FlagException["safetyEventService.recordSafetyEvent()
        * isFlagged = true
        * Notes: '[EXCEPTION: Dropped off without prior boarding record]'"]:::verifiedLogic
        SeqCheck -->|No| RecordClean["safetyEventService.recordSafetyEvent()
        * Normal safety event logged"]:::verifiedLogic

        AuditCorrection["Audit Correction Action:
        * safetyEventService.auditCorrectEvent()
        * Requires mandatory justification note (>= 5 chars)
        * Preserves auditCorrection & correctionHistory"]:::verifiedLogic

        FlagException & RecordClean --> StorageSave[("Saved to ERPStorage.transportSafetyEvents")]:::storageState
        StorageSave --> AuditCorrection
    end

