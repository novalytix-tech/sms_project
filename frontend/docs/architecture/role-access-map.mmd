        R_Teacher --> T_Permitted
        R_Teacher --> T_Restricted
    end

    subgraph CLASS_TEACHER_SCOPE ["4. Designated Class Teacher Scope (Teacher + Assignment)"]
        CT_Permitted["ELEVATED PRIVILEGES (isClassTeacher === true):
        * Full Roster Management for Assigned Class (e.g. Class 10-A)
        * Assign Students to Class Section from Unassigned Pool
        * Create Class-Specific Broadcast Group (Class 10-A Group)
        * Initiate Academic Year Promotion Review for Assigned Class
        * Export Assigned Class Attendance & Academic Reports"]:::permittedOp
        CT_Restricted["REMAINING RESTRICTIONS:
        * Cannot promote classes assigned to other teachers
        * Cannot configure school-wide fee structures or policies
        * Cannot alter institutional master settings"]:::restrictedOp
        R_ClassTeacher --> CT_Permitted
        R_ClassTeacher --> CT_Restricted
    end

