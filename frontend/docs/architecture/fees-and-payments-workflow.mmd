flowchart TD
    classDef adminAction fill:#fff1f2,stroke:#be123c,stroke-width:2px,color:#881337;
    classDef parentAction fill:#fffbeb,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef simulatedGateway fill:#eff6ff,stroke:#2563eb,stroke-width:2px,stroke-dasharray: 4 4,color:#1e3a8a;
    classDef storageState fill:#faf5ff,stroke:#9333ea,stroke-width:2px,color:#581c87;
    classDef missingIntegration fill:#fef2f2,stroke:#ef4444,stroke-width:2px,stroke-dasharray: 5 5,color:#991b1b;

    subgraph FEE_SETUP ["1. Fee Structure & Policy Configuration (Admin)"]
        ConfigPolicy["School Admin configures Fee Policy:
        * Currency: INR (₹)
        * Sibling Discount % (e.g. 10%)
        * Grace Period Days & Late Fee/Day
        * Allow Partial Payments toggle"]:::adminAction

        CreateStructure["Define Fee Structures by Class & Term:
        * Class 10: Term 1 Tuition (₹28,000)
        * Examination Fee (₹2,500)
        * Science Lab Fee (₹3,000)
        * Transport Fee (from Bus Stop assignment)"]:::adminAction

        GenerateInvoices["feeService.generateTermInvoices()
        * Generates FeeInvoice for each enrolled student
        * Invoice No: INV-2026-XXXX
        * Initial Status: 'pending' (or 'overdue' if past due date)"]:::adminAction

        ConfigPolicy --> CreateStructure --> GenerateInvoices
    end

    subgraph PARENT_VIEW ["2. Parent / Student Invoice Discovery"]
        OpenFeePortal["Parent / Student opens /fees
        * Scoped strictly to logged-in student or linked ward
        * Total Outstanding Balance Banner
        * Invoice list: Pending, Partial, Paid, Overdue"]:::parentAction

        SelectInvoice["Parent clicks 'Pay Online' or 'View Details' on invoice"]:::parentAction

        GenerateInvoices --> OpenFeePortal --> SelectInvoice
    end

    subgraph PAYMENT_FLOW ["3. Payment Checkout Flow"]
        OpenPayModal["PayNowModal Opens:
        * Displays Invoice Breakdown & Items
        * Select Full Amount or Custom Partial Amount
        * Sibling Discount applied if eligible"]:::parentAction

        ChooseMethod{"Payment Method Selected"}:::parentAction

        SelectInvoice --> OpenPayModal --> ChooseMethod

        MethodUPI["UPI Payment:
        * Instant UPI QR Code (Demo)
        * UPI VPA ID (e.g. parent@oksbi)"]:::parentAction

        MethodNetBanking["Net Banking:
        * Bank Selector (HDFC, ICICI, SBI, Axis)"]:::parentAction

        MethodCard["Credit / Debit Card:
        * Card Number, Expiry, CVV"]:::parentAction

        ChooseMethod --> MethodUPI & MethodNetBanking & MethodCard

        ClickPay["Parent clicks 'Pay ₹XX,XXX'"]:::parentAction
        MethodUPI & MethodNetBanking & MethodCard --> ClickPay
    end

    subgraph GATEWAY_REALITY ["4. Gateway Processing (SIMULATED vs MISSING REAL GATEWAY)"]
        DemoProcess["paymentService.processDemoPayment()
        (IMPLEMENTED SIMULATION)
        * Generates Transaction Ref: TXN-2026-XXXXX
        * Simulates 1.2s gateway processing delay
        * Channel: 'online_demo'
        * Status: 'completed'"]:::simulatedGateway

        RealGateway["REAL PAYMENT GATEWAY (MISSING IN PRODUCTION)
        * Razorpay / PayU / BillDesk Webhook
        * Bank Settlement & Merchant Reconciliation
        * Escrow & Chargeback Handling"]:::missingIntegration

        ClickPay --> DemoProcess
        ClickPay -.->|Production Needs| RealGateway
    end

    subgraph RECEIPT_AND_BALANCE ["5. Balance Update, Receipt & Audit"]
        UpdateInvoice["Update FeeInvoice in ERPStorage:
        * paidAmount += amountPaid
        * remainingBalance = totalAmount - paidAmount
        * Status: 'paid' (if balance=0) or 'partial'"]:::storageState

        CreateTxn["Record in paymentTransactions collection"]:::storageState

        GenerateReceipt["paymentService.generateReceipt()
        * Receipt No: RCP-2026-XXXX
        * Student details, Fee category breakdown
        * School Name, Affiliation & Official Stamp"]:::storageState

        DemoProcess --> UpdateInvoice & CreateTxn & GenerateReceipt

        PrintableModal["PrintableReceiptModal Opens:
        * Official A4 Printable Institutional Receipt
        * Print Action & PDF Export"]:::parentAction

        GenerateReceipt --> PrintableModal
    end

