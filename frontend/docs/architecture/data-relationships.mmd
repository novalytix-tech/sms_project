erDiagram
    %% Core Security and Identity
    USER {
        string id PK "Unique User UUID"
        string email UK "User login email"
        string role "super_admin | school_admin | teacher | student | parent | supplier"
        string referenceId FK "Polymorphic link: Teacher.id | Student.id | User.id"
        string institutionId FK "Optional multi-tenant institution pointer"
    }

    ACADEMIC_SESSION {
        string id PK "e.g. sess-2025-26 | sess-2026-27 | sess-2027-28"
        string name "Session title e.g. 2026-2027"
        string startDate "YYYY-MM-DD"
        string endDate "YYYY-MM-DD"
        boolean isCurrent "Single active academic session flag"
        string status "active | upcoming | archived"
        string previousSessionId FK "Chain pointer to previous session"
        string nextSessionId FK "Chain pointer to next planned session"
    }

    CLASS_ROOM {
        string id PK "e.g. c10-a | c9-b"
        string name "Class grade name e.g. Class 10"
        int grade "Numeric grade 1 to 12"
        string section "Section identifier A | B | C"
        string sessionId FK "Explicit link to AcademicSession.id"
        string classTeacherId FK "Assigned Teacher.id"
        string classTeacherName "Cached teacher display name"
        int capacity "Maximum allowed student enrollment"
        int studentCount "Live computed or cached enrollment count"
        string status "active | inactive"
    }

    TEACHER {
        string id PK "Teacher UUID"
        string staffId UK "Staff ID code e.g. TCH-001"
        string fullName "Teacher complete legal name"
        string email UK "Official email address"
        string designation "e.g. Senior PGT Teacher"
        string department "Academic department e.g. Science"
        string assignedClasses "Array of {classId, className, section, isClassTeacher}"
        string status "active | on_leave | inactive"
    }

    STUDENT {
        string id PK "Permanent Student UUID (Persistent across academic sessions)"
        string admissionNo UK "Permanent School Admission No e.g. ADM-2026-001"
        string fullName "Complete legal name"
        string classId FK "Active class pointer"
        string className "Active class grade display"
        string section "Active section e.g. A"
        string rollNo "Section roll number"
        string academicYear "Current academic year label"
        string parentId FK "Links to User.id (Parent role)"
        string parentName "Parent / Guardian legal name"
        string parentPhone "Emergency contact number"
        string status "active | inactive | suspended | alumni | transferred"
        string transportRouteId FK "Optional link to TransportRoute.id"
        string busStop "Assigned pickup / drop bus stop name"
    }

    STUDENT_ENROLLMENT {
        string id PK "Enrollment ledger UUID"
        string studentId FK "Permanent reference to Student.id"
        string admissionNo "Student school admission number"
        string sessionId FK "Reference to AcademicSession.id"
        string classId FK "Reference to ClassRoom.id"
        string section "Assigned section"
        string rollNo "Assigned roll number for session"
        string status "active | promoted | retained | withdrawn"
        string promotionBatchId FK "Optional reference to PromotionBatch.id"
    }

    PROMOTION_BATCH {
        string id PK "Promotion execution batch UUID"
        string sourceSessionId FK "Origin AcademicSession.id"
        string destinationSessionId FK "Target AcademicSession.id"
        string sourceClassId FK "Origin ClassRoom.id"
        string destinationClassId FK "Target ClassRoom.id"
        string promotedStudentIds "Array of student UUIDs marked for promotion"
        string retainedStudentIds "Array of student UUIDs retained in class"
        string promotedByStaffId FK "Staff UUID who executed promotion batch"
        string executedAt "ISO timestamp of batch commit"
    }

    ADMISSION_APPLICATION {
        string id PK "Admission record UUID"
        string applicationNo UK "Format: APP-2026-XXXX"
        string targetClassId FK "Target ClassRoom.id"
        string academicYear "Academic year string e.g. 2026-2027"
        string studentName "Applicant student name"
        string status "inquiry | applied | under_review | interview_scheduled | approved | waitlisted | rejected | enrolled"
        string enrolledStudentId FK "Generated Student.id upon enrollment completion"
    }

    ATTENDANCE_RECORD {
        string id PK "Composite key: classId-date-studentId"
        string classId FK "ClassRoom.id"
        string section "Class section"
        string date "Date string YYYY-MM-DD"
        string studentId FK "Student.id"
        string status "present | absent | late | half_day | excused"
        string remarks "Optional absence reason"
    }

    STAFF_ATTENDANCE_RECORD {
        string id PK "Staff attendance UUID"
        string teacherId FK "Teacher.id"
        string staffId "Staff employee code"
        string date "Date string YYYY-MM-DD"
        string status "present | absent | late | half_day | on_leave"
    }

    ASSIGNMENT {
        string id PK "Assignment UUID"
        string title "Assignment title"
        string classId FK "ClassRoom.id"
        string section "Class section"
        string subject "Academic subject e.g. Mathematics"
        string teacherId FK "Teacher.id (Author)"
        string dueDate "Submission deadline ISO string"
        int maxScore "Total marks possible"
        string status "active | closed"
    }

    ASSIGNMENT_SUBMISSION {
        string id PK "Submission UUID"
        string assignmentId FK "Assignment.id"
        string studentId FK "Student.id (Author)"
        string status "pending | draft | submitted | graded | resubmission_requested"
        int score "Awarded score"
        string feedback "Teacher grading notes"
        boolean isPublished "Student visibility release toggle"
    }

    EXAMINATION {
        string id PK "Exam series UUID"
        string title "Exam title e.g. Mid-Term Examination 2026"
        string examType "mid_term | final | unit_test | quarterly"
        string classId FK "ClassRoom.id"
        string academicYear "Academic session identifier"
        string status "upcoming | ongoing | completed"
    }

    EXAM_MARK {
        string id PK "Mark record UUID"
        string examId FK "Examination.id"
        string scheduleId FK "Exam schedule paper UUID"
        string studentId FK "Student.id"
        float marksObtained "Scored marks"
        boolean isAbsent "True if student was absent"
    }

    FEE_INVOICE {
        string id PK "Invoice UUID"
        string invoiceNo UK "Invoice code e.g. INV-2026-001"
        string studentId FK "Student.id"
        string admissionNo "Student school admission number"
        string academicYear "Billing academic year"
        float totalAmount "Total payable sum"
        float paidAmount "Cumulative settled amount"
        string status "paid | partial | pending | overdue"
        string dueDate "Payment deadline"
    }

    PAYMENT_TRANSACTION {
        string id PK "Payment ledger transaction UUID"
        string transactionRef UK "Reference code e.g. TXN-20260401-XXXX"
        string invoiceId FK "FeeInvoice.id"
        string studentId FK "Student.id"
        string parentId FK "User.id (Parent payer)"
        float amount "Transaction amount"
        string method "UPI | Credit Card | Debit Card | Net Banking | Cash | Cheque"
        string status "success | pending | failed"
        string receiptNo "Generated receipt voucher code"
    }

    CLASS_GROUP {
        string id PK "Class announcement group UUID"
        string classId FK "ClassRoom.id"
        string section "Class section"
        string classTeacherId FK "Teacher.id (Admin of group)"
        string status "active | archived"
    }

    CLASS_GROUP_MESSAGE {
        string id PK "Message UUID"
        string groupId FK "ClassGroup.id"
        string classId FK "ClassRoom.id"
        string senderId FK "User.id / Teacher.id"
        string category "announcement | homework | reminder | event | urgent"
        string title "Subject headline"
        string content "Message body text"
    }

    STAFF_GROUP {
        string id PK "Staff communication channel UUID"
        string name "Group name e.g. Senior Faculty Council"
        string type "all_staff | department | committee | management | custom"
        string creatorId FK "User.id who created group"
        string status "active | archived"
    }

    STAFF_GROUP_MESSAGE {
        string id PK "Staff message UUID"
        string groupId FK "StaffGroup.id"
        string senderId FK "User.id (Staff sender)"
        string content "Message text content"
        boolean isAnnouncement "High-priority broadcast marker"
    }

    TRANSPORT_ROUTE {
        string id PK "Route UUID"
        string routeNumber UK "Identifier e.g. Route-101"
        string vehicleNo "Registration number e.g. DL-01-AB-1234"
        string vehicleType "Bus | Mini-Bus | Van"
        string driverName "Designated driver full name"
        string driverPhone "Driver mobile contact"
        string attendantName "Designated bus attendant"
        string attendantPhone "Attendant mobile contact"
        int capacity "Seating capacity"
        float schoolLatitude "Destination latitude e.g. 28.6139"
        float schoolLongitude "Destination longitude e.g. 77.2090"
    }

    TRANSPORT_TRIP {
        string id PK "Daily transit trip UUID"
        string routeId FK "TransportRoute.id"
        string routeNumber "Cached route code e.g. Route-101"
        string vehicleNo "Bus registration number"
        string tripType "morning_pickup | afternoon_drop"
        string tripDate "Transit date YYYY-MM-DD"
        string status "scheduled | in_progress | completed | cancelled"
    }

    TRANSPORT_SAFETY_EVENT {
        string id PK "Safety audit log UUID"
        string tripId FK "TransportTrip.id"
        string routeId FK "TransportRoute.id"
        string studentId FK "Student.id"
        string eventType "boarded | dropped_off | not_boarded | exception"
        string stopId "BusStop identifier"
        boolean isFlagged "Emergency or unexpected boarding flag"
    }

    TRANSPORT_ALERT {
        string id PK "Safety alert notification UUID"
        string tripId FK "TransportTrip.id"
        string routeId FK "TransportRoute.id"
        string studentId FK "Optional Student.id"
        string alertType "approaching_stop | arrived_at_school | student_boarded | student_dropped | trip_delayed | route_deviation | gps_offline"
        string severity "low | medium | high | critical"
        string timestamp "ISO event time"
    }

    %% Entity Relationships
    USER ||--o| TEACHER : "links if teacher role"
    USER ||--o| STUDENT : "links if student role"
    USER ||--o{ STUDENT : "parent of (via Student.parentId)"
    USER ||--o{ PAYMENT_TRANSACTION : "executes payment"
    USER ||--o{ STAFF_GROUP_MESSAGE : "posts messages"

    ACADEMIC_SESSION ||--o{ CLASS_ROOM : "configures academic classes"
    ACADEMIC_SESSION ||--o{ STUDENT_ENROLLMENT : "records session rosters"
    ACADEMIC_SESSION ||--o{ PROMOTION_BATCH : "source and target of promotions"

    TEACHER ||--o{ CLASS_ROOM : "serves as Class Teacher"
    TEACHER ||--o{ ASSIGNMENT : "creates assignments"
    TEACHER ||--o{ STAFF_ATTENDANCE_RECORD : "records daily presence"
    TEACHER ||--o{ CLASS_GROUP : "administers class announcements"

    CLASS_ROOM ||--o{ STUDENT : "contains enrolled active students"
    CLASS_ROOM ||--o{ STUDENT_ENROLLMENT : "historical and active session roster"
    CLASS_ROOM ||--o{ ATTENDANCE_RECORD : "daily roll call"
    CLASS_ROOM ||--o{ ASSIGNMENT : "assigned homework"
    CLASS_ROOM ||--o{ EXAMINATION : "scheduled class examinations"
    CLASS_ROOM ||--o| CLASS_GROUP : "broadcast communication group"

    STUDENT ||--|{ STUDENT_ENROLLMENT : "career progression history"
    STUDENT ||--o{ ATTENDANCE_RECORD : "daily attendance markings"
    STUDENT ||--o{ ASSIGNMENT_SUBMISSION : "submits work"
    STUDENT ||--o{ EXAM_MARK : "scores exam marks"
    STUDENT ||--o{ FEE_INVOICE : "billed school fees"
    STUDENT ||--o{ PAYMENT_TRANSACTION : "associated fee payments"
    STUDENT ||--o{ TRANSPORT_SAFETY_EVENT : "boarding and drop safety logs"
    STUDENT }o--o| TRANSPORT_ROUTE : "opts into school transit"

    ADMISSION_APPLICATION ||--o| STUDENT : "converts to student upon enrollment"

    ASSIGNMENT ||--o{ ASSIGNMENT_SUBMISSION : "receives student homework"

    EXAMINATION ||--o{ EXAM_MARK : "records student scores"

    FEE_INVOICE ||--o{ PAYMENT_TRANSACTION : "settled through transactions"

    CLASS_GROUP ||--o{ CLASS_GROUP_MESSAGE : "broadcasts class notices"

    STAFF_GROUP ||--o{ STAFF_GROUP_MESSAGE : "contains channel chat logs"

    TRANSPORT_ROUTE ||--o{ TRANSPORT_TRIP : "executes morning and afternoon trips"
    TRANSPORT_TRIP ||--o{ TRANSPORT_SAFETY_EVENT : "logs student passenger events"
    TRANSPORT_TRIP ||--o{ TRANSPORT_ALERT : "triggers deviation and status alerts"

