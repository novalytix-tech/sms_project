flowchart TD
    classDef adminAction fill:#fff1f2,stroke:#be123c,stroke-width:2px,color:#881337;
    classDef teacherAction fill:#f0fdf4,stroke:#15803d,stroke-width:2px,color:#14532d;
    classDef decisionCheck fill:#fffbeb,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef warningModal fill:#fef3c7,stroke:#b45309,stroke-width:2px,color:#78350f;
    classDef storageRecord fill:#faf5ff,stroke:#9333ea,stroke-width:2px,color:#581c87;
    classDef blockedAction fill:#fee2e2,stroke:#ef4444,stroke-width:1px,color:#991b1b;

    subgraph GROUP_CREATION ["1. Group Creation & Permission Checks"]
        OpenCreate["User clicks 'Create Staff Group' on /staff-groups"]
        CheckUserRole{"User Role & Capabilities?"}:::decisionCheck

        OpenCreate --> CheckUserRole

        AdminOptions["Admin Privilege (canCreateAllStaffGroups: true)
        * All Staff Group (School-Wide)
        * Department Groups (e.g. Science Dept)
        * Role-Based Groups (e.g. All Teachers)
        * Custom Collaboration Groups"]:::adminAction

        TeacherOptions["Teacher Privilege (canCreateCustomStaffGroups: true)
        * Custom Groups Only
        * Cannot create All-Staff or Department groups"]:::teacherAction

        CheckUserRole -->|school_admin / super_admin| AdminOptions
        CheckUserRole -->|teacher| TeacherOptions
        CheckUserRole -->|student / parent / supplier| BlockAccess["Access Restricted (BLOCKED)"]:::blockedAction

        SelectMembers["Select Eligible Members:
        * Filter by department, role, or individual staff
        * Dynamic member counter calculated"]

        AdminOptions & TeacherOptions --> SelectMembers

        PersistGroup["staffGroupService.createGroup()
        * Stored in ERPStorage.staffGroups
        * Creator logged, memberIds stored
        * Status: 'active'"]:::storageRecord

        SelectMembers --> PersistGroup
    end

    subgraph MESSAGE_COMPOSITION ["2. Message Composition & Safety Guard"]
        SelectGroup["User selects group from 'My Groups' list"]
        ComposeMessage["Compose Announcement:
        * Subject / Title
        * Body text
        * Category: 'announcement' | 'academic' | 'operational' | 'emergency'
        * Priority: 'normal' | 'high' | 'urgent'
        * Attachment URL / document link"]

        PersistGroup --> SelectGroup --> ComposeMessage

        CheckReach{"Recipient Member Count > 20?"}:::decisionCheck
        ComposeMessage --> CheckReach

        HighReachWarning["High-Reach Broadcast Warning Modal:
        * Displays exact recipient count (e.g. 48 Staff)
        * Prompts user to confirm school-wide broadcast
        * Prevents duplicate clicks / accidental spam"]:::warningModal

        DirectSend["Immediate Send (Standard Reach)"]

        CheckReach -->|Yes| HighReachWarning
        CheckReach -->|No| DirectSend

        ConfirmBroadcast{"User Confirms Send?"}:::decisionCheck
        HighReachWarning --> ConfirmBroadcast
        ConfirmBroadcast -->|Cancel| ComposeMessage
        ConfirmBroadcast -->|Confirm| SaveMessage
        DirectSend --> SaveMessage
    end

    subgraph PERSISTENCE_AND_RECEIPTS ["3. Persistence, Read Receipts & Notifications"]
        SaveMessage["staffGroupService.sendMessage()
        * ID: msg-XXXXX
        * Sender staff details & role
        * Timestamp & message content
        * readByStaffIds: [senderId]"]:::storageRecord

        UpdateGroupMeta["Update Group Metadata:
        * lastMessageAt = new Date()
        * totalMessagesCount++"]:::storageRecord

        SaveMessage --> UpdateGroupMeta

        MemberInbox["Member Roster Discovery:
        * Unread badge counter increments for members
        * Message renders in group thread"]

        UpdateGroupMeta --> MemberInbox

        MemberReads["Staff member opens message thread:
        * markAsRead(groupId, messageId, staffId)
        * Staff ID appended to readByStaffIds
        * Unread count decrements"]

        MemberInbox --> MemberReads
    end

    subgraph GROUP_LIFECYCLE ["4. Group Archiving & Audit History"]
        ArchiveGroup["Admin / Creator clicks 'Archive Group'
        * Requires canArchiveStaffGroups capability
        * Group status becomes 'archived'"]:::adminAction

        ReadOnlyState["Archived Group State:
        * Message history remains fully searchable and readable
        * Compose input is disabled (no new messages permitted)
        * Preserves institutional communication audit trail"]:::storageRecord

        ArchiveGroup --> ReadOnlyState
    end

