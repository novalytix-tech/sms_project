FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-2026
JWT_SECRET_KEY=change-this-jwt-secret-in-production-2026
PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Database (PostgreSQL) ------------------------------------------------
# true: connect to PostgreSQL (DATABASE_URL required). false: DB endpoints return 503.
DATABASE_ENABLED=true
# PRIMARY: Supabase (Session pooler) — Dashboard > Project Settings > Database
#          > Connection string > "Session pooler". Change postgresql:// to postgresql+psycopg2://
# DATABASE_URL=postgresql+psycopg2://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# FUTURE (GCP Cloud SQL) — to migrate later, replace the single line above with:
# DATABASE_URL=postgresql+psycopg2://USER:PASS@/school_erp?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# --- Development authentication -------------------------------------------
# Database-free login using dev_auth_accounts.json (Argon2id hashes, git-ignored).
# Only honoured while DATABASE_ENABLED=false; startup fails if set in production.
DEV_AUTH_ENABLED=false
# DEV_AUTH_ACCOUNTS_FILE=dev_auth_accounts.json

# --- SMS delivery (credentials / notifications) ---------------------------
# Provider for real SMS: console (default = no real send, logs to outbox),
# msg91, or fast2sms. Until a provider + keys are set, the UI will honestly
# report "SMS Not Sent" instead of falsely claiming delivery.
SMS_PROVIDER=console
# 6-char DLT-approved sender/header, e.g. STXAVR
SMS_SENDER_ID=
SCHOOL_NAME=St. Xavier's Academy
FRONTEND_URL=http://localhost:5173

# MSG91 (https://control.msg91.com) — requires a DLT-approved Flow template
# whose variables map to name / login id / password.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Fast2SMS (https://www.fast2sms.com)
# FAST2SMS_ROUTE=dlt needs FAST2SMS_SENDER_ID + FAST2SMS_MESSAGE_ID (DLT template id).
# FAST2SMS_ROUTE=q is the quick-SMS route for testing only.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_MESSAGE_ID=
