# Copy to backend/.env for local development. Never commit the real .env.
FLASK_ENV=development
PORT=5000

# Local: the Postgres from docker-compose.yml (or any local Postgres).
# Production (Render): Supabase "Session pooler" connection string, with ?sslmode=require
DATABASE_URL=postgresql://sms:sms_local_dev@127.0.0.1:5434/sms

# Clerk (dashboard -> Configure -> API keys). Secret key stays on the backend only.
CLERK_SECRET_KEY=<your-clerk-secret-key>
# Optional networkless verification: paste the "JWKS Public Key" PEM (use \n for newlines).
CLERK_JWT_KEY=
# Origins allowed to use session tokens (the frontend URL). Required in production.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: shared rate-limit storage when running more than one worker/instance.
REDIS_URL=

# Local seeding only: your Clerk sign-in email becomes the seeded principal (school_admin).
SEED_ADMIN_EMAIL=
